{
  "name": "financial-webapplication",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed:emulators": "node scripts/seed-emulator-users.mjs",
    "test:e2e": "npx playwright test",
    "test:tracking:e2e": "npx playwright test tests/e2e/customer-activity.spec.js",
    "test:staff:e2e": "npx playwright test tests/e2e/staff-operations.spec.js",
    "test:auth": "npx playwright test tests/e2e/auth.spec.js",
    "test:ui": "npx playwright test tests/e2e/ui.spec.js",
    "test:rules": "npx vitest run tests/integration/firestore-rules.test.js",
    "test:referral:integration": "npx vitest run tests/integration/referral-commission.test.js",
    "test:staff:integration": "npx vitest run tests/integration/staff-history.test.js",
    "test:tracking:integration": "npx vitest run tests/integration/customer-traceability.test.js tests/integration/customer-activity-validation.test.js",
    "test:tracking": "npm run test:tracking:integration && npm run test:tracking:e2e",
    "test:all": "npm run test:rules && npm run test:auth && npm run test:ui"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}
