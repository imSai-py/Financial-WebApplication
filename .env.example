# ============================================================
# FinanceFlow - Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the values.
#
# Firebase client-side config is required in non-emulator environments.
# Prefix variables with VITE_ so Vite exposes them to the client.
# ============================================================

# Firebase Client Configuration (required for production/staging)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Emulator Configuration
# Set this to `true` only when Auth, Firestore, and Functions emulators are all running.
# VITE_USE_FIREBASE_EMULATORS=false
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
# VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8081
# VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001

# Firebase Admin SDK (for scripts in /scripts)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json
